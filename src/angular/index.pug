doctype html
html(lang="ko")
    head
        meta(charset="utf-8")
        title 명함장
        base(href="/")
        
        meta(name='viewport' content='width=device-width, initial-scale=1.0, viewport-fit=cover')
        meta(http-equiv='X-UA-Compatible' content='ie=edge')

        // pwa config
        meta(name='application-name' content='명함장')
        meta(name='description' content='사진 분석 기반 명함 관리 PWA')
        meta(name='msapplication-TileColor' content='#0f766e')
        meta(name='theme-color' content='#0f766e')
        meta(name='apple-mobile-web-app-status-bar-style' content='black-translucent')
        meta(name='apple-mobile-web-app-capable' content='yes')
        meta(name='apple-mobile-web-app-title' content='명함장')
        meta(name='mobile-web-app-capable' content='yes')
        meta(name='HandheldFriendly' content='True')
        meta(name='MobileOptimized' content='320')
        link(rel="shortcut icon", href="/assets/brand/icon.ico")

        link(rel="apple-touch-icon" sizes="192x192" href="/assets/brand/icon-192.png")
        link(rel="apple-touch-icon" sizes="512x512" href="/assets/brand/icon-512.png")
        link(rel="apple-touch-icon" href="/assets/brand/icon-192.png")

        link(rel="icon" sizes="192x192" type="image/png" href="/assets/brand/icon-192.png")
        link(rel="icon" sizes="512x512" type="image/png" href="/assets/brand/icon-512.png")
        link(rel="icon" href="/assets/brand/icon.ico")

        link(rel="manifest" href="/manifest.json")

        script(type="text/javascript").
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('/sw.js', { scope: '/' }).then(function () {});
                });
            }

    body
        app-root
