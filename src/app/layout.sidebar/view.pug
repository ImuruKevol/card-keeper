div(class="app-shell")
    header(class="app-header")
        div(class="header-inner")
            a(routerLink="/cards", class="brand-link", aria-label="명함장")
                img(src="/assets/brand/logo-black.svg", alt="명함장", class="brand-logo")
            nav(class="app-nav", aria-label="주요 메뉴")
                a(routerLink="/cards", routerLinkActive="is-active", class="nav-item primary-nav-item", aria-label="명함 목록")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15A2.25 2.25 0 0 0 21.75 17.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15A2.25 2.25 0 0 0 2.25 6.75v10.5A2.25 2.25 0 0 0 4.5 19.5Z")
                    span(class="desktop-nav-label") 명함 관리
                    span(class="mobile-nav-label") 목록
                a(routerLink="/my-card", routerLinkActive="is-active", class="nav-item primary-nav-item", aria-label="내 명함")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75A3 3 0 1 1 9 9.75a3 3 0 0 1 6 0Z")
                    span(class="desktop-nav-label") 내 명함
                    span(class="mobile-nav-label") 내 명함
                a(*ngIf="service.auth.check.role('admin')", routerLink="/users", routerLinkActive="is-active", class="nav-item admin-nav-item", aria-label="사용자 관리")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772")
                    span 사용자 관리
                a(*ngIf="service.auth.check.role('admin')", routerLink="/ai-settings", routerLinkActive="is-active", class="nav-item admin-nav-item", aria-label="AI 설정")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Zm8.25-5.654.563 1.969 1.969.563-1.969.563-.563 1.969-.563-1.969-1.969-.563 1.969-.563.563-1.969Zm0-7.5.563 1.969 1.969.563-1.969.563-.563 1.969-.563-1.969-1.969-.563 1.969-.563.563-1.969Z")
                    span AI 설정
            div(class="header-actions")
                div(class="user-chip")
                    span(class="user-avatar") {{(service.auth.session?.name || 'U').charAt(0)}}
                    span(class="user-meta")
                        strong {{service.auth.session?.name || 'User'}}
                        small {{service.auth.session?.email || ''}}
                button(type="button", (click)="openPasswordForm()", class="icon-button", title="비밀번호 변경")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z")
                    span(class="sr-only") 비밀번호 변경
                a(href="/auth/logout", class="icon-button danger", title="로그아웃")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6A2.25 2.25 0 0 0 5.25 5.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9")
                    span(class="sr-only") 로그아웃

    main(class="app-main")
        router-outlet

div(*ngIf="showPasswordForm", class="dialog-scrim")
    div(class="password-dialog")
        div(class="dialog-header")
            div
                h2 비밀번호 변경
                p {{service.auth.session?.email || ''}}
            button(type="button", (click)="closePasswordForm()", class="ghost-icon")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M6 18 18 6M6 6l12 12")
        div(class="dialog-body")
            div(class="field-group")
                label 현재 비밀번호
                input(type="password", [(ngModel)]="passwordForm.current_password", autocomplete="current-password", class="form-input")
            div(class="field-group")
                label 새 비밀번호
                input(type="password", [(ngModel)]="passwordForm.new_password", autocomplete="new-password", class="form-input")
            div(class="field-group")
                label 새 비밀번호 확인
                input(type="password", [(ngModel)]="passwordForm.new_password_confirm", autocomplete="new-password", (keyup.enter)="changePassword()", class="form-input")
        div(class="dialog-actions")
            button(type="button", (click)="closePasswordForm()", [disabled]="passwordBusy", class="secondary-button") 취소
            button(type="button", (click)="changePassword()", [disabled]="passwordBusy", class="primary-button") {{passwordBusy ? '변경 중...' : '변경'}}

wiz-portal-season-modal
div(*ngIf="service.status.loading", class="loading-overlay")
    wiz-portal-season-loading-season(className="w-12 h-12 text-orange-500 animate-spin duration-700")
