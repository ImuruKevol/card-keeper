div(class="access-page")
    section(class="brand-panel")
        div(class="brand-content")
            img(src="/assets/brand/logo-white.svg", alt="명함장", class="brand-logo")
            div(class="card-visual", aria-hidden="true")
                div(class="sample-card primary")
                    span(class="sample-mark") CK
                    div
                        strong Kwon Taeuk
                        small Product Lead
                div(class="sample-card secondary")
                    span(class="sample-line wide")
                    span(class="sample-line")
                    span(class="sample-line short")
            div(class="brand-caption")
                h1 명함장
                p Card Keeper
    section(class="auth-panel")
        div(class="auth-card")
            div(class="auth-heading")
                h2 {{mode === 'login' ? '로그인' : '가입 신청'}}
                p {{mode === 'login' ? '계정 정보를 입력해주세요.' : '승인 후 서비스를 이용할 수 있습니다.'}}
            div(class="auth-tabs")
                button(type="button", (click)="setMode('login')", class="auth-tab", [ngClass]="mode === 'login' ? 'is-active' : ''") 로그인
                button(type="button", (click)="setMode('signup')", class="auth-tab", [ngClass]="mode === 'signup' ? 'is-active' : ''") 가입 신청

            div(class="auth-form", *ngIf="mode === 'login'")
                div(class="field-group")
                    label 이메일
                    input(type="email", autocomplete="email", [(ngModel)]="loginData.email", placeholder="name@example.com", class="form-input")
                div(class="field-group")
                    label 비밀번호
                    input(type="password", autocomplete="current-password", [(ngModel)]="loginData.password", (keyup.enter)="login()", placeholder="비밀번호", class="form-input")
                button(type="button", (click)="login()", [disabled]="busy", class="primary-button")
                    svg(*ngIf="busy", class="spinner", viewBox="0 0 24 24")
                        circle(class="spinner-track", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4", fill="none")
                        path(class="spinner-fill", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z")
                    span 로그인

            div(class="auth-form", *ngIf="mode === 'signup'")
                div(class="field-group")
                    label 이름
                    input(type="text", autocomplete="name", [(ngModel)]="signupData.name", class="form-input")
                div(class="field-group")
                    label 이메일
                    input(type="email", autocomplete="email", [(ngModel)]="signupData.email", class="form-input")
                div(class="field-group")
                    label 연락처
                    input(type="text", [(ngModel)]="signupData.mobile", placeholder="010-0000-0000", class="form-input")
                div(class="two-column")
                    div(class="field-group")
                        label 비밀번호
                        input(type="password", autocomplete="new-password", [(ngModel)]="signupData.password", class="form-input")
                    div(class="field-group")
                        label 비밀번호 확인
                        input(type="password", autocomplete="new-password", [(ngModel)]="signupData.password_confirm", (keyup.enter)="signup()", class="form-input")
                button(type="button", (click)="signup()", [disabled]="busy", class="primary-button")
                    svg(*ngIf="busy", class="spinner", viewBox="0 0 24 24")
                        circle(class="spinner-track", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4", fill="none")
                        path(class="spinner-fill", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z")
                    span 가입 신청
