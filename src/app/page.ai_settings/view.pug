main(class="ai-settings-workbench")
    section(class="settings-panel")
        div(class="panel-head")
            div
                h2 Provider
                p {{setting.enabled ? '활성' : '비활성'}}
            label(class="switch")
                input(type="checkbox", [(ngModel)]="setting.enabled")
                span
        div(class="provider-grid")
            button(*ngFor="let provider of providers", type="button", (click)="selectProvider(provider)", [ngClass]="providerButtonClass(provider)")
                strong {{provider.label}}
                small {{provider.value}}

        div(class="form-grid")
            div(class="field-group span-2")
                label API Key
                div(class="inline-field api-key-field")
                    input(type="password", [(ngModel)]="setting.api_key", [placeholder]="apiKeyPlaceholder()", class="form-input")
                    button(*ngIf="setting.has_api_key", type="button", (click)="clearApiKey()", class="icon-button", title="API Key 삭제")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                            path(stroke-linecap="round", stroke-linejoin="round", d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673A2.25 2.25 0 0 1 15.916 21H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0")
                    button(type="button", (click)="loadModels()", [disabled]="modelLoading", class="secondary-action load-model-action")
                        svg(*ngIf="modelLoading", class="spinner", viewBox="0 0 24 24")
                            circle(class="spinner-track", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4", fill="none")
                            path(class="spinner-fill", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z")
                        svg(*ngIf="!modelLoading", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M8.332 4.15a8.25 8.25 0 0 1 13.803 3.7m0 0V2.858m0 4.992h-4.992")
                        span {{modelLoading ? '불러오는 중' : '모델 불러오기'}}
            div(class="field-group", *ngIf="setting.provider === 'ollama'")
                label Base URL
                input(type="text", [(ngModel)]="setting.base_url", class="form-input")
            div(class="field-group span-2")
                label 모델 ID
                input(type="text", [(ngModel)]="setting.model", list="ai-model-options", class="form-input", placeholder="모델 ID")
                datalist(id="ai-model-options")
                    option(*ngIf="setting.model && !modelInList(setting.model)", [value]="setting.model") {{setting.model}}
                    option(*ngFor="let model of models", [value]="model.id") {{model.label}}
            div(class="form-actions span-2")
                button(type="button", (click)="save()", [disabled]="!canSave()", class="primary-action") {{saving ? '저장 중...' : '저장'}}

    section(class="models-panel")
        div(class="panel-head")
            div
                h2 OCR 모델
                p {{models.length}}개
        div(class="model-list")
            div(*ngIf="loading", class="empty-row") 로딩 중...
            div(*ngIf="!loading && models.length === 0", class="empty-row") 모델 없음
            button(*ngFor="let model of models", type="button", (click)="setting.model = model.id", [ngClass]="setting.model === model.id ? 'model-row is-selected' : 'model-row'")
                span {{model.label}}
                small {{model.provider}}
