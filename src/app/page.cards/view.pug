input(#uploadInput="", type="file", accept="image/*", (change)="onPhotoSelected($event)", class="hidden")
input(#cameraInput="", type="file", accept="image/*", capture="environment", (change)="onPhotoSelected($event)", class="hidden")
input(#importInput="", type="file", accept=".csv,.txt,.xlsx,text/csv,text/plain,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", (change)="onImportSelected($event)", class="hidden")

section(class="page-toolbar")
    div(class="toolbar-inner")
        div(class="page-title")
            span(class="title-icon")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15A2.25 2.25 0 0 0 21.75 17.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15A2.25 2.25 0 0 0 2.25 6.75v10.5A2.25 2.25 0 0 0 4.5 19.5Z")
            div
                h1 명함 관리
                p 총 {{allTotal}}건
        div(class="toolbar-actions")
            button(type="button", (click)="startImport(importInput)", [disabled]="importing", class="secondary-action", title="가져오기", aria-label="가져오기")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5")
                span {{importing ? '가져오는 중' : '가져오기'}}
            button(type="button", (click)="openExport()", [disabled]="exporting", class="secondary-action export-action", title="내보내기", aria-label="내보내기")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5A3.375 3.375 0 0 0 10.125 2.25H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z")
                span {{exporting ? '내보내는 중' : '내보내기'}}
            button(type="button", (click)="openCapture()", class="primary-action", title="명함 등록", aria-label="명함 등록")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M6.827 6.175A2.31 2.31 0 0 1 9.186 4.5h5.628c1.038 0 1.953.69 2.24 1.675l.15.525A2.31 2.31 0 0 0 19.444 8.25H19.5A2.25 2.25 0 0 1 21.75 10.5v6.75a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V10.5A2.25 2.25 0 0 1 4.5 8.25h.056A2.31 2.31 0 0 0 6.797 6.7l.03-.525Zm5.173 10.5a3.375 3.375 0 1 0 0-6.75 3.375 3.375 0 0 0 0 6.75Z")
                span 명함 등록

main(class="cards-workbench")
    section(class="capture-panel")
        div(class="capture-copy")
            span(class="eyebrow") 빠른 등록
            h2 사진 기반 등록
            p 새 명함
        div(class="capture-actions")
            button(type="button", (click)="startPhotoSelect('front', uploadInput)", class="secondary-action")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5")
                span 업로드
            button(type="button", (click)="startPhotoSelect('front', cameraInput)", class="dark-action")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M6.827 6.175A2.31 2.31 0 0 1 9.186 4.5h5.628c1.038 0 1.953.69 2.24 1.675l.15.525A2.31 2.31 0 0 0 19.444 8.25H19.5A2.25 2.25 0 0 1 21.75 10.5v6.75a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V10.5A2.25 2.25 0 0 1 4.5 8.25h.056A2.31 2.31 0 0 0 6.797 6.7l.03-.525Z")
                span 촬영

    section(class="list-controls")
        div(class="filter-row")
            label(class="search-field list-search")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z")
                input(type="text", [(ngModel)]="search.text", (keyup.enter)="load(1)", [placeholder]="searchPlaceholder()")
                button(*ngIf="search.text", type="button", (click)="clearSearchText()", class="search-clear-button", title="검색어 지우기", aria-label="검색어 지우기")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.8", stroke="currentColor")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M6 18 18 6M6 6l12 12")
            div(class="list-total-count")
                div(class="count-item")
                    small 총 명함
                    strong {{allTotal}}
                span(class="count-divider", aria-hidden="true")
                div(class="count-item")
                    small 검색 결과
                    strong {{total}}
            div(class="segmented-control sort-mode", role="group", aria-label="정렬 기준")
                button(type="button", (click)="setSort('name')", [ngClass]="search.sort === 'name' ? 'is-active' : ''") 이름순
                button(type="button", (click)="setSort('company')", [ngClass]="search.sort === 'company' ? 'is-active' : ''") 회사순
            div(class="segmented-control sort-direction", role="group", aria-label="정렬 방향")
                button(type="button", (click)="setSortDirection('asc')", [ngClass]="search.direction === 'asc' ? 'is-active' : ''") 오름차순
                button(type="button", (click)="setSortDirection('desc')", [ngClass]="search.direction === 'desc' ? 'is-active' : ''") 내림차순

    div(id="cardsListTop", class="list-scroll-target", aria-hidden="true")

    section(class="table-shell desktop-only")
        table(class="data-table")
            thead
                tr
                    th(class="card-image-col") 앞면
                    th 이름
                    th 회사/부서
                    th 직책
                    th 연락처
                    th(class="align-right") 작업
            tbody
                tr(*ngIf="loading")
                    td(colspan="6", class="empty-cell") 로딩 중...
                tr(*ngIf="!loading && cards.length === 0")
                    td(colspan="6", class="empty-cell") 등록된 명함이 없습니다.
                tr(*ngFor="let card of cards")
                    td
                        button(type="button", (click)="openEdit(card)", class="table-thumb", title="명함 앞면 보기")
                            img(*ngIf="card.front_image", [src]="card.front_image", alt="", loading="lazy")
                            span(*ngIf="!card.front_image") 앞면
                    td
                        button(type="button", (click)="openEdit(card)", class="name-button") {{card.name}}
                        div(class="subtext", *ngIf="card.email") {{card.email}}
                    td
                        div(class="strong-text") {{card.company || '-'}}
                        div(class="subtext", *ngIf="card.department") {{card.department}}
                    td {{card.position || '-'}}
                    td {{primaryContact(card)}}
                    td
                        div(class="row-actions")
                            button(type="button", (click)="openEdit(card)", class="table-icon", title="수정")
                                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z")
                            button(type="button", (click)="remove(card)", class="table-icon danger", title="삭제")
                                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673A2.25 2.25 0 0 1 15.916 21H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916")

    section(class="mobile-list")
        div(*ngIf="loading", class="mobile-empty") 로딩 중...
        div(*ngIf="!loading && cards.length === 0", class="mobile-empty") 등록된 명함이 없습니다.
        article(*ngFor="let card of cards", class="mobile-card")
            button(type="button", (click)="openEdit(card)", class="mobile-card-button")
                div(class="mobile-card-info")
                    strong {{card.name || '이름 없음'}}
                    p(*ngIf="roleLine(card)") {{roleLine(card)}}
                    p(class="mobile-company", *ngIf="card.company") {{card.company}}
                    p(class="mobile-contact", *ngIf="primaryContact(card) !== '-'") {{primaryContact(card)}}
                div(class="mobile-card-thumb")
                    img(*ngIf="card.front_image", [src]="card.front_image", alt="", loading="lazy")
                    span(*ngIf="!card.front_image") 앞면 없음

    section(*ngIf="totalPages() > 1", class="pagination-bar")
        div(class="pagination-summary") {{search.page}} / {{totalPages()}}
        nav(class="pagination-controls", aria-label="명함 목록 페이지")
            button(type="button", (click)="goToPage(1)", [disabled]="search.page <= 1", class="pagination-arrow", title="맨 앞으로", aria-label="맨 앞으로")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.7", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M18.75 19.5 11.25 12l7.5-7.5M12.75 19.5 5.25 12l7.5-7.5")
            button(type="button", (click)="goToPage(search.page - 1)", [disabled]="search.page <= 1", class="pagination-arrow", title="이전", aria-label="이전")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.7", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M15.75 19.5 8.25 12l7.5-7.5")
            button(*ngFor="let page of paginationPages()", type="button", (click)="goToPage(page)", [class.is-active]="page === search.page", class="page-number-button") {{page}}
            button(type="button", (click)="goToPage(search.page + 1)", [disabled]="search.page >= totalPages()", class="pagination-arrow", title="다음", aria-label="다음")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.7", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="m8.25 4.5 7.5 7.5-7.5 7.5")
            button(type="button", (click)="goToPage(totalPages())", [disabled]="search.page >= totalPages()", class="pagination-arrow", title="맨 뒤로", aria-label="맨 뒤로")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.7", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="m5.25 4.5 7.5 7.5-7.5 7.5M11.25 4.5l7.5 7.5-7.5 7.5")

div(*ngIf="showExport", class="modal-scrim")
    div(class="export-modal")
        div(class="import-header")
            div(class="min-w-0")
                h2 내보내기
                p 현재 검색 조건의 명함을 파일로 저장합니다.
            button(type="button", (click)="closeExport()", class="close-button")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M6 18 18 6M6 6l12 12")
        div(class="export-body")
            button(*ngFor="let option of exportOptions()", type="button", (click)="selectExportFormat(option.key)", [ngClass]="exportFormat === option.key ? 'is-active' : ''", class="export-format-option")
                strong {{option.label}}
                span {{option.description}}
        div(class="import-actions")
            button(type="button", (click)="closeExport()", class="secondary-action") 취소
            button(type="button", (click)="confirmExport()", [disabled]="exporting", class="primary-action") {{exporting ? '내보내는 중...' : '내보내기'}}

div(*ngIf="showImport", class="modal-scrim")
    div(class="import-modal")
        div(class="import-header")
            div(class="min-w-0")
                h2 파일 가져오기
                p {{importFileName || 'CSV, TXT, XLSX'}}
            button(type="button", (click)="closeImport()", class="close-button")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M6 18 18 6M6 6l12 12")
        div(class="import-body")
            section(class="import-settings")
                div(class="import-setting-card")
                    h3 파일 설정
                    label(class="import-select-row")
                        span 구분 기호
                        select([(ngModel)]="importOptions.delimiter", (change)="onImportOptionChanged()", [disabled]="importPreview.extension === '.xlsx'")
                            option(*ngFor="let option of importDelimiterOptions()", [value]="option.key") {{option.label}}
                    label(class="import-check-row")
                        input(type="checkbox", [(ngModel)]="importOptions.has_header", (change)="onImportOptionChanged()")
                        span 첫 행을 머리글로 사용
                    label(class="import-check-row")
                        input(type="checkbox", [(ngModel)]="importOptions.append_unmapped_to_memo")
                        span 매핑 안 된 컬럼을 메모에 추가
                    div(class="import-detected")
                        small 감지됨
                        strong {{importPreview.detected_delimiter || '-'}}
                div(class="import-setting-card")
                    h3 중복 처리
                    div(class="duplicate-control", role="group", aria-label="중복 처리")
                        button(*ngFor="let option of duplicateOptions()", type="button", (click)="setDuplicateMode(option.key)", [ngClass]="importOptions.duplicate === option.key ? 'is-active' : ''") {{option.label}}
                div(class="import-stats")
                    div
                        small 행
                        strong {{importPreview.total_rows || 0}}
                    div
                        small 컬럼
                        strong {{importPreview.columns.length || 0}}
                    div
                        small 매핑
                        strong {{mappedFieldCount()}}
            section(class="import-mapping")
                div(class="import-section-title")
                    h3 컬럼 매핑
                    span 이름 필수
                div(*ngIf="mappingDuplicateErrors().length > 0", class="mapping-error-box")
                    strong 중복 매핑
                    span {{mappingErrorMessage()}}
                div(*ngIf="importing && importMappings.length === 0", class="import-empty") 파일을 분석하는 중...
                div(*ngIf="!importing && importMappings.length === 0", class="import-empty") 매핑할 컬럼이 없습니다.
                div(class="mapping-list")
                    div(*ngFor="let mapping of importMappings; let index = index", class="mapping-row", [ngClass]="mappingRowClass(mapping)")
                        div(class="mapping-source")
                            strong {{mapping.header}}
                            small {{importColumnSample(index)}}
                        select([(ngModel)]="mapping.field")
                            option(*ngFor="let option of importFieldOptions()", [value]="option.key") {{option.label}}
            section(class="import-preview")
                div(class="import-section-title")
                    h3 가져오기 결과 미리보기
                    span {{importMappedPreviewRows().length || 0}}행 표시
                div(class="preview-table-wrap")
                    table(class="preview-table")
                        thead
                            tr
                                th(class="preview-row-number") 행
                                th(*ngFor="let column of importResultColumns()") {{column.label}}
                        tbody
                            tr(*ngIf="importing")
                                td([attr.colspan]="importResultColumns().length + 1", class="empty-cell") 미리보기 생성 중...
                            tr(*ngIf="!importing && importMappedPreviewRows().length === 0")
                                td([attr.colspan]="importResultColumns().length + 1", class="empty-cell") 표시할 데이터가 없습니다.
                            tr(*ngFor="let row of importMappedPreviewRows()")
                                td(class="preview-row-number") {{row.__row}}
                                td(*ngFor="let column of importResultColumns()") {{importMappedPreviewCell(row, column.key)}}
        div(class="import-actions")
            button(type="button", (click)="closeImport()", class="secondary-action") 취소
            button(type="button", (click)="confirmImport()", [disabled]="!canImport()", class="primary-action") {{importing ? '처리 중...' : '가져오기 실행'}}

div(*ngIf="showForm", class="modal-scrim")
    div(*ngIf="formMode === 'create'", class="card-editor registration-editor")
        div(class="editor-header")
            div(class="min-w-0")
                h2 사진 분석 등록
                p {{captureTitle()}}
            button(type="button", (click)="closeForm()", class="close-button")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M6 18 18 6M6 6l12 12")
        div(class="editor-body")
            section(class="image-panel")
                div(class="panel-header")
                    h3 명함 이미지
                    span(class="analysis-pill", [ngClass]="analysisClass()") {{analysis.message || '대기'}}
                div(class="side-tabs")
                    button(*ngFor="let slot of captureSlots", type="button", (click)="selectCaptureSide(slot.side)", [ngClass]="slotClass(slot)")
                        span {{slot.label}}
                        small {{slot.preview ? '촬영 완료' : '대기'}}
                div(class="image-frame")
                    img(*ngIf="activeCaptureSlot().preview", [src]="activeCaptureSlot().preview", alt="", class="preview-image")
                    div(*ngIf="!activeCaptureSlot().preview", class="image-empty") {{activeCaptureSlot().label}} 이미지 없음
                div(class="panel-actions")
                    button(type="button", (click)="startPhotoSelect(activeCaptureSide, uploadInput)", class="light-action")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5")
                        span 업로드
                    button(type="button", (click)="startPhotoSelect(activeCaptureSide, cameraInput)", class="outline-light-action")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M6.827 6.175A2.31 2.31 0 0 1 9.186 4.5h5.628c1.038 0 1.953.69 2.24 1.675l.15.525A2.31 2.31 0 0 0 19.444 8.25H19.5A2.25 2.25 0 0 1 21.75 10.5v6.75a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V10.5A2.25 2.25 0 0 1 4.5 8.25h.056A2.31 2.31 0 0 0 6.797 6.7l.03-.525Z")
                        span 촬영
                    button(type="button", (click)="analyzePhoto()", [disabled]="!hasCapturedImages() || analyzing", class="accent-action")
                        svg(*ngIf="analyzing", class="spinner", viewBox="0 0 24 24")
                            circle(class="spinner-track", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4", fill="none")
                            path(class="spinner-fill", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z")
                        svg(*ngIf="!analyzing", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z")
                        span {{analyzing ? '분석 중' : '분석'}}
                div(class="analysis-grid")
                    div
                        small 진행률
                        strong {{analysis.progress || 0}}%
                    div
                        small 신뢰도
                        strong {{analysis.confidence || 0}}%
                    div
                        small 엔진
                        strong {{analysis.engine || '-'}}
                    div
                        small 촬영
                        strong {{capturedImageCount()}}/2
            section(class="form-panel")
                h3 추출 정보
                div(class="form-grid")
                    div(class="field-group")
                        label 이름
                        input(type="text", [(ngModel)]="form.name", class="form-input")
                    div(class="field-group")
                        label 회사
                        input(type="text", [(ngModel)]="form.company", class="form-input")
                    div(class="field-group")
                        label 부서
                        input(type="text", [(ngModel)]="form.department", class="form-input")
                    div(class="field-group")
                        label 직책
                        input(type="text", [(ngModel)]="form.position", class="form-input")
                    div(class="field-group")
                        label 이메일
                        input(type="email", [(ngModel)]="form.email", class="form-input")
                    div(class="field-group")
                        label 휴대폰
