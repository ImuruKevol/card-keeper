                            span(*ngIf="!field.href") {{field.value}}
                            button(type="button", (click)="copyField(field.key, field.value)", class="copy-button", [class.is-copied]="copiedField === field.key", title="복사")
                                svg(*ngIf="copiedField !== field.key", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75A1.125 1.125 0 0 1 3.75 20.625v-9.75c0-.621.504-1.125 1.125-1.125H8.25m7.5 7.5h3.375c.621 0 1.125-.504 1.125-1.125v-9.75c0-.621-.504-1.125-1.125-1.125h-9.75c-.621 0-1.125.504-1.125 1.125V9.75")
                                svg(*ngIf="copiedField === field.key", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="m4.5 12.75 6 6 9-13.5")
                section(*ngIf="contactFields().length > 0", class="detail-section")
                    h3 연락처
                    div(*ngFor="let field of contactFields()", class="detail-field")
                        small {{field.label}}
                        div(class="detail-value-row")
                            a(*ngIf="field.href", [href]="field.href", [attr.target]="field.target", [attr.rel]="field.rel", class="detail-value-link", [title]="field.actionTitle", [attr.aria-label]="field.actionTitle") {{field.value}}
                            span(*ngIf="!field.href") {{field.value}}
                            button(type="button", (click)="copyField(field.key, field.value)", class="copy-button", [class.is-copied]="copiedField === field.key", title="복사")
                                svg(*ngIf="copiedField !== field.key", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75A1.125 1.125 0 0 1 3.75 20.625v-9.75c0-.621.504-1.125 1.125-1.125H8.25m7.5 7.5h3.375c.621 0 1.125-.504 1.125-1.125v-9.75c0-.621-.504-1.125-1.125-1.125h-9.75c-.621 0-1.125.504-1.125 1.125V9.75")
                                svg(*ngIf="copiedField === field.key", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="m4.5 12.75 6 6 9-13.5")
                section(*ngIf="memoFields().length > 0", class="detail-section")
                    h3 메모
                    div(*ngFor="let field of memoFields()", class="detail-field")
                        small {{field.label}}
                        div(class="detail-value-row")
                            a(*ngIf="field.href", [href]="field.href", [attr.target]="field.target", [attr.rel]="field.rel", class="detail-value-link", [title]="field.actionTitle", [attr.aria-label]="field.actionTitle") {{field.value}}
                            span(*ngIf="!field.href") {{field.value}}
                            button(type="button", (click)="copyField(field.key, field.value)", class="copy-button", [class.is-copied]="copiedField === field.key", title="복사")
                                svg(*ngIf="copiedField !== field.key", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75A1.125 1.125 0 0 1 3.75 20.625v-9.75c0-.621.504-1.125 1.125-1.125H8.25m7.5 7.5h3.375c.621 0 1.125-.504 1.125-1.125v-9.75c0-.621-.504-1.125-1.125-1.125h-9.75c-.621 0-1.125.504-1.125 1.125V9.75")
                                svg(*ngIf="copiedField === field.key", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="m4.5 12.75 6 6 9-13.5")
            section(*ngIf="formMode === 'edit'", class="detail-main detail-edit-main")
                h3 정보 수정
                div(class="form-grid detail-form-grid")
                    div(class="field-group")
                        label 이름
                        input(type="text", [(ngModel)]="form.name", class="form-input")
                    div(class="field-group")
                        label 회사
                        input(type="text", [(ngModel)]="form.company", class="form-input")
                    div(class="field-group")
                        label 부서
                        input(type="text", [(ngModel)]="form.department", class="form-input")
                    div(class="field-group")
                        label 직책
                        input(type="text", [(ngModel)]="form.position", class="form-input")
                    div(class="field-group")
                        label 이메일
                        input(type="email", [(ngModel)]="form.email", class="form-input")
                    div(class="field-group")
                        label 휴대폰
                        input(type="text", [(ngModel)]="form.mobile", class="form-input")
                    div(class="field-group")
                        label 전화
                        input(type="text", [(ngModel)]="form.phone", class="form-input")
