div(*ngIf="cropper.visible", class="cropper-scrim")
    div(class="cropper-shell")
        div(class="cropper-topbar")
            div(class="min-w-0")
                h2 {{cropper.label}} 명함 영역 맞춤
                p {{cropper.fileName}}
            div(class="cropper-top-actions")
                button(type="button", (click)="resetCropper()", class="cropper-secondary") 초기화
                button(type="button", (click)="cancelCropper()", class="cropper-secondary") 취소
                button(type="button", (click)="applyCropper()", class="cropper-primary") 적용
        div(class="cropper-stage", (pointerdown)="startCropDrag($event)", (pointermove)="moveCropDrag($event)", (pointerup)="endCropDrag($event)", (pointercancel)="endCropDrag($event)", (wheel)="onCropWheel($event)")
            img([src]="cropper.imageUrl", draggable="false", alt="", class="cropper-photo")
            div(class="crop-frame")
                span(class="crop-corner crop-corner-tl")
                span(class="crop-corner crop-corner-tr")
                span(class="crop-corner crop-corner-bl")
                span(class="crop-corner crop-corner-br")
        div(class="cropper-controls")
            label
                span 확대
                input(type="range", min="1", max="4", step="0.01", value="1", (input)="onCropScaleInput($event)", class="cropper-scale-input")
                strong(class="cropper-scale-value") 1
